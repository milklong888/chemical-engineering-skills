{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-family-datasheet-v1",
  "title": "Authority-profile equipment family datasheet",
  "$defs": {
    "estimate": {
      "type": "object", "additionalProperties": true,
      "required": ["field_id", "value", "state", "evidence_class", "result_status", "promotion_cap", "inference_basis", "assumptions", "context_refs", "lower_bound", "upper_bound", "registered_allowed_values", "registry_id", "confidence", "sensitivity_note"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1}, "value": {"type": ["number", "string"]}, "state": {"type": "string", "minLength": 1},
        "evidence_class": {"const": "J"}, "result_status": {"const": "PROVISIONAL"}, "promotion_cap": {"const": "TYPE_SCREENING"},
        "inference_basis": {"enum": ["unit_conversion", "same_case_fact_interpretation", "engineering_requirement", "registered_range_interpolation", "conservative_screening_assumption"]},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "lower_bound": {"type": ["number", "null"]}, "upper_bound": {"type": ["number", "null"]},
        "registered_allowed_values": {"type": "array", "items": {"type": "string", "minLength": 1}}, "registry_id": {"type": ["string", "null"]},
        "confidence": {"enum": ["low", "medium"]}, "sensitivity_note": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"properties": {"value": {"type": "number"}, "lower_bound": {"type": "number"}, "upper_bound": {"type": "number"}}},
        {"properties": {"value": {"type": "string"}, "lower_bound": {"type": "null"}, "upper_bound": {"type": "null"}, "registered_allowed_values": {"type": "array", "minItems": 1}, "registry_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "equipmentDisclosure": {
      "type": "object", "additionalProperties": true,
      "required": ["llm_used", "status", "model_estimate_fields", "applied_model_estimate_fields", "superseded_model_estimate_fields", "estimates", "evidence_class", "promotion_cap", "statement"],
      "properties": {
        "llm_used": {"type": "boolean"}, "status": {"enum": ["NOT_USED", "PROVISIONAL_ESTIMATES_USED", "MODEL_ESTIMATES_SUPERSEDED"]},
        "model_estimate_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "applied_model_estimate_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "superseded_model_estimate_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "estimates": {"type": "array", "items": {"$ref": "#/$defs/estimate"}}, "evidence_class": {"type": ["string", "null"], "enum": ["J", null]}, "promotion_cap": {"type": ["string", "null"], "enum": ["TYPE_SCREENING", null]}, "statement": {"type": "string", "minLength": 1}
      }
    },
    "aggregateDisclosure": {
      "type": "object", "additionalProperties": false,
      "required": ["llm_used", "status", "equipment", "statement"],
      "properties": {"llm_used": {"type": "boolean"}, "status": {"enum": ["NOT_USED", "PROVISIONAL_ESTIMATES_USED", "MODEL_ESTIMATES_SUPERSEDED"]}, "equipment": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/equipmentDisclosure"}, {"type": "object", "required": ["equipment_key"], "properties": {"equipment_key": {"type": "string", "minLength": 1}}}]}}, "statement": {"type": "string", "minLength": 1}}
    }
  },
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "equipment_count", "equipment", "deterministic", "llm_used", "model_estimate_disclosure"],
  "properties": {
    "schema": {"const": "equipment-family-datasheet-v1"},
    "equipment_count": {"type": "integer", "minimum": 0},
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "equipment_key", "family_ids", "profile_ids", "profile_resolution",
          "fields", "customer_table_missing_fields", "algorithm_evidence_missing_fields",
          "missing_information", "evidence_ids", "evidence_level",
          "terminal_selection_status", "terminal_selection_basis", "terminal_default_applied",
          "terminal_rule_id", "terminal_assumption", "input_sha256", "llm_used", "model_estimate_disclosure"
        ],
        "properties": {
          "equipment_key": {"type": "string", "minLength": 1},
          "family_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "profile_resolution": {"type": "string"},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "field_id", "label", "value", "state", "source", "requirement",
                "evidence_gate", "source_refs", "profile_ids"
              ],
              "properties": {
                "field_id": {"type": "string", "minLength": 1},
                "label": {"type": "string"},
                "state": {"type": "string"},
                "source": {"type": "object"},
                "profile_ids": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "customer_table_missing_fields": {"type": "array", "items": {"type": "string"}},
          "algorithm_evidence_missing_fields": {"type": "array", "items": {"type": "string"}},
          "terminal_selection_status": {"type": ["string", "null"]},
          "terminal_selection_basis": {"type": ["string", "null"]},
          "terminal_default_applied": {"type": "boolean"},
          "terminal_rule_id": {"type": ["string", "null"]},
          "terminal_assumption": {"type": ["string", "null"]},
          "input_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "llm_used": {"type": "boolean"},
          "model_estimate_disclosure": {"$ref": "#/$defs/equipmentDisclosure"}
        }
      }
    },
    "deterministic": {"const": true},
    "llm_used": {"type": "boolean"},
    "model_estimate_disclosure": {"$ref": "#/$defs/aggregateDisclosure"}
  }
}
