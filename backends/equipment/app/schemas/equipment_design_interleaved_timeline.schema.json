{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-design-interleaved-timeline-v1",
  "title": "Equipment Design Program/AI Interleaved Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "title", "deterministic_result_preserved",
    "ai_controls_intermediate_composition", "steps", "timeline_sha256"
  ],
  "properties": {
    "schema": {"const": "equipment-design-interleaved-timeline-v1"},
    "title": {"type": "string"},
    "deterministic_result_preserved": {"const": true},
    "ai_controls_intermediate_composition": {"type": "boolean"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "actor", "operation", "status", "authoritative", "immutable"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "actor": {"enum": ["program", "ai"]},
          "operation": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "authoritative": {"type": "boolean"},
          "immutable": {"type": "boolean"},
          "result_ref": {"type": ["string", "null"]},
          "result_sha256": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[A-F0-9]{64}$"}
            ]
          },
          "heading": {"type": "string"},
          "payload_ref": {"type": "string"},
          "citations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "timeline_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
