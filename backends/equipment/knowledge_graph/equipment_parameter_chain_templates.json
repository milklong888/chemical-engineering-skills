{
  "schema": "equipment-parameter-chain-templates-v1",
  "version": "1.6.0",
  "customer_output_profiles_path": "equipment_customer_output_profiles.json",
  "customer_output_policy": {
    "authority": "original customer Excel/Word headers plus promoted equipment overview field-schema nodes",
    "value_transfer": "forbidden; the profile carries field structure and evidence gates only",
    "family_ambiguity": "retain the union at the most-general supported family until a deterministic discriminator closes a subtype",
    "missing_fields": "retain every required row; apply only registered context fallbacks as visibly RECOMMENDED or DEFAULTED preliminary values, and keep formal evidence gaps open"
  },
  "workflow": [
    "normalize_and_unit_convert",
    "identify_equipment_family",
    "calculate_all_closable_parameters",
    "build_parameter_package",
    "run_constraint_checks",
    "match_type_standard_or_vendor_candidates",
    "rank_candidates_and_explain_rejections",
    "promote_only_after_same_equipment_evidence"
  ],
  "selection_policy": {
    "type_screening": "allowed after family identity is deterministic",
    "candidate_matching": "may consume only the parameter package selection_feature_vector",
    "partial_input": "show calculated and missing rows; retain the most general type candidate; do not fabricate a model",
    "formal_model": "requires the family evidence gate and independent approval"
  },
  "visual_template": {
    "parameter_columns": ["group", "label", "symbol", "value", "unit", "source", "status", "equation_chain"],
    "candidate_columns": ["rank", "designation", "kind", "status", "score", "formal_model"],
    "status_legend": {
      "CALCULATED": "由本次明确输入按公式链计算",
      "PROVIDED": "由 Aspen、手工输入或调用方提供，尚需来源证据",
      "MISSING": "当前没有值，选型或正式门可能因此未闭合",
      "EXTERNAL_REQUIRED": "必须由标准查表、同设备软件或厂家证据闭合",
      "RECOMMENDED": "由图谱条件规则或内置推荐公式补入，仅供预设计并保留告警",
      "DEFAULTED": "最终保底默认值，仅用于不中停的预设计计算，必须做敏感性复核"
    }
  },
