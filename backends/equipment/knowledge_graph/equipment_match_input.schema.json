{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equipment-match-input-v1",
  "title": "设备设计图谱与脚本离线匹配输入",
  "$defs": {
    "equipmentRecord": {
      "type": "object",
      "description": "至少提供设备族、设备类型、Aspen块类型或工艺功能之一。中文别名由匹配器归一化；下列为推荐规范字段。",
      "properties": {
        "equipment_tag": {"type": "string"},
        "equipment_family": {"type": "string"},
        "equipment_type": {"type": "string"},
        "aspen_block_type": {"type": "string"},
        "process_function": {"type": "string"},
        "phase": {"enum": ["liquid", "gas", "vapor", "mixed", "solid"]},
        "pressure_basis": {"enum": ["absolute", "gauge"]},
        "design_pressure_basis": {"enum": ["absolute", "gauge"]},
        "atmospheric_pressure_mpa": {"type": "number", "exclusiveMinimum": 0},
        "flow_m3_h": {"type": "number", "exclusiveMinimum": 0},
        "mass_flow_kg_h": {"type": "number", "exclusiveMinimum": 0},
        "head_m": {"type": "number", "minimum": 0},
        "density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
        "efficiency_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "inlet_pressure_mpa": {"type": "number"},
        "outlet_pressure_mpa": {"type": "number"},
        "operating_pressure_mpa": {"type": "number"},
        "design_pressure_mpa": {"type": "number"},
        "design_pressure_factor": {"type": "number", "minimum": 1},
        "temperature_c": {"type": "number"},
        "inlet_temperature_c": {"type": "number"},
        "outlet_temperature_c": {"type": "number"},
        "design_temperature_c": {"type": "number"},
        "pressure_drop_kpa": {"type": "number", "minimum": 0},
        "allowable_pressure_drop_kpa": {"type": "number", "minimum": 0},
        "maximum_pressure_drop_kpa": {"type": "number", "minimum": 0},
        "maximum_pressure_drop_factor": {"type": "number", "minimum": 1},
        "heat_duty_kw": {"type": "number"},
        "specific_heat_kj_kgk": {"type": "number", "exclusiveMinimum": 0},
        "heat_transfer_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "overall_u_w_m2k": {"type": "number", "exclusiveMinimum": 0},
        "lmtd_k": {"type": "number", "exclusiveMinimum": 0},
        "lmtd_correction_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "straight_shell_length_mm": {"type": "number", "exclusiveMinimum": 0},
        "volume_m3": {"type": "number", "exclusiveMinimum": 0},
        "volume_basis": {"enum": ["nominal_total", "effective_working", "geometric_total"]},
        "required_volume_m3": {"type": "number", "exclusiveMinimum": 0},
        "straight_shell_geometric_volume_m3": {"type": "number", "exclusiveMinimum": 0},
        "stage_count": {"type": "integer", "minimum": 1},
        "retention_time_min": {"type": "number", "exclusiveMinimum": 0},
        "fill_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "inner_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "allowable_stress_mpa": {"type": "number", "exclusiveMinimum": 0},
        "weld_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "head_type": {"enum": ["2:1_ellipsoidal"]},
        "cylinder_calculated_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
        "head_calculated_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
        "npsha_m": {"type": "number"},
        "npshr_m": {"type": "number", "minimum": 0},
        "required_npsh_margin_m": {"type": "number", "minimum": 0},
        "npshr_evidence_scope": {"enum": ["same_duty_vendor_curve"]},
        "gas_molecular_weight": {"type": "number", "exclusiveMinimum": 0},
        "compressibility_factor": {"type": "number", "exclusiveMinimum": 0},
        "surge_margin_percent": {"type": "number"},
        "required_surge_margin_percent": {"type": "number", "minimum": 0},
        "surge_margin_evidence_scope": {"enum": ["same_duty_performance_map"]},
        "cavitation_margin_m": {"type": "number"},
        "rotational_speed_rpm": {"type": "number", "exclusiveMinimum": 0},
        "shaft_power_kw": {"type": "number", "exclusiveMinimum": 0},
        "pressure_drop_power_component_kw": {"type": "number", "exclusiveMinimum": 0},
        "mixing_metric": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
        "membrane_geometry_type": {"enum": ["cylindrical_channels", "spiral_wound", "hollow_fiber", "flat_sheet"]},
        "pressure_drop_head_component_m": {"type": "number", "exclusiveMinimum": 0},
        "pressure_component_shaft_power_screening_kw": {"type": "number", "exclusiveMinimum": 0},
        "membrane_area_m2": {"type": "number", "exclusiveMinimum": 0},
        "flux": {"type": "number", "exclusiveMinimum": 0},
        "selectivity": {"type": "number", "exclusiveMinimum": 0},
        "recovery_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "capacity": {"type": "number", "exclusiveMinimum": 0},
        "cycle_time_h": {"type": "number", "exclusiveMinimum": 0},
        "cv": {"type": "number", "exclusiveMinimum": 0},
        "element_count": {"type": "integer", "minimum": 1},
        "channel_count": {"type": "integer", "minimum": 1},
        "channel_inner_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "element_length_m": {"type": "number", "exclusiveMinimum": 0},
        "target_velocity_m_s": {"type": "number", "exclusiveMinimum": 0},
        "selected_dn": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "string", "pattern": "^(?:[Dd][Nn])?\\s*[0-9]+(?:\\.[0-9]+)?$"}]},
        "selected_outer_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
        "selected_wall_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
        "wall_series": {"type": "string"},
        "fitting_type": {"type": "string"},
        "connection_type": {"type": "string"},
        "pressure_class": {"type": "string"},
        "flange_face": {"type": "string"},
        "gasket_material": {"type": "string"},
        "valve_function": {"type": "string"},
        "material": {"type": "string"},
        "candidate_model": {"type": "string"},
        "vendor_model": {"type": "string"},
        "vendor_datasheet_path": {"type": "string"},
        "verification_result": {"type": "string"},
        "approval_status": {"type": "string"},
        "vendor_datasheet_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "vendor_curve_path": {"type": "string"},
        "vendor_curve_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "software_result_path": {"type": "string"},
        "software_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "mechanical_result_path": {"type": "string"},
        "mechanical_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "internals_result_path": {"type": "string"},
        "internals_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "relief_result_path": {"type": "string"},
        "relief_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "stress_result_path": {"type": "string"},
        "stress_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "standard_lookup_path": {"type": "string"},
        "standard_lookup_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "compatibility_result_path": {"type": "string"},
        "compatibility_result_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "primary_literature_path": {"type": "string"},
        "primary_literature_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "process_guarantee_path": {"type": "string"},
        "process_guarantee_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "formal_calculation_path": {"type": "string"},
        "formal_calculation_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "evidence_manifest_path": {"type": "string"},
        "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "audit_approval_path": {"type": "string"},
        "audit_approval_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
      },
      "anyOf": [
        {"required": ["equipment_family"]},
        {"required": ["equipment_type"]},
        {"required": ["aspen_block_type"]},
        {"required": ["process_function"]}
      ],
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/equipmentRecord"},
    {"type": "array", "items": {"$ref": "#/$defs/equipmentRecord"}, "minItems": 1},
    {
      "type": "object",
      "required": ["equipment"],
      "properties": {"equipment": {"type": "array", "items": {"$ref": "#/$defs/equipmentRecord"}, "minItems": 1}},
      "additionalProperties": false
    }
  ]
}
